<?xml version="1.0" encoding="utf-8"?>
<!--
  Identical to ic_launcher.xml — an adaptive icon is mask-agnostic BY
  DESIGN, so `android:roundIcon` needs a resource to point at, not
  different artwork. See ic_launcher.xml for how the layers are generated
  and how to regenerate them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
