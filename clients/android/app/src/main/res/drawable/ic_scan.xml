<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera/scan glyph — CARD 1's header, and the same drawable stands in for
  the live preview in the "no CAMERA permission yet" placeholder state (see
  MainActivity.buildScanPlaceholder). Single-colour outline, 24x24 grid,
  1.7 stroke — the shared vocabulary every icon in res/drawable/ uses so
  the four read as one family instead of four mismatched glyphs (task
  brief). Tinted at runtime via ImageView.imageTintList, never carries its
  own colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- viewfinder bump -->
    <path
        android:pathData="M9.5,4.3 H14.5 V7.3 H9.5 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- body -->
    <path
        android:pathData="M5,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V9 A2,2 0 0 1 5,7 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- lens -->
    <path
        android:pathData="M8,13 A4,4 0 1 0 16,13 A4,4 0 1 0 8,13"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
