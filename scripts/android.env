# scripts/android.env — pinned Android toolchain versions.
#
# Android is the one target docs/DESIGN.md §8.5 builds NATIVELY rather than in a
# pinned container, and §8.1 gives its CI job `ubuntu-latest` + SDK/NDK
# rather than a `container:`. There is therefore no image digest to pin the
# way scripts/toolchains.env pins devkitARM — this file is the equivalent.
# scripts/android-sdk-bootstrap.sh and .github/workflows/ci.yml both source
# it, so local and CI resolve the same packages.
#
# Unlike toolchains.env this file IS hand-edited: there is no `docker pull`
# to resolve a floating tag against. Bump deliberately, one line at a time,
# and rerun scripts/android-sdk-bootstrap.sh.
#
# Checked 2026-08-10 against dl.google.com/android/repository/repository2-3.xml
# (channel "stable" only), Google's Maven, and services.gradle.org.

# ---- JDK: the JVM Gradle itself runs on --------------------------------
# Separate knob from the bytecode target in build.gradle.kts.
APAD_JDK_FEATURE=17
APAD_JDK_BUILD=17.0.20+8
APAD_JDK_URL="https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.20%2B8/OpenJDK17U-jdk_x64_linux_hotspot_17.0.20_8.tar.gz"
APAD_JDK_SHA256=be7668bc030d578b83d6d5ef9221d6d6729bbbca8cf94a7d52e16ac68b5a5a35

# ---- Android SDK -------------------------------------------------------
APAD_CMDLINE_TOOLS_VERSION=22.0
APAD_CMDLINE_TOOLS_BUILD=15859902
# Google publishes SHA-1 for these, not SHA-256. Not our choice.
APAD_CMDLINE_TOOLS_SHA1=040d3996a65543d22ec4bf73e4c37aa37a8d4af4

APAD_COMPILE_SDK=36
APAD_TARGET_SDK=36
# API 26 (Android 8.0). Below 26 there is no NotificationChannel and no
# startForegroundService, and the foreground Service is the app's spine
# (docs/DESIGN.md §7.2) rather than an optional extra.
APAD_MIN_SDK=26
APAD_BUILD_TOOLS=37.0.0

# ---- NDK ---------------------------------------------------------------
# r28 LTS rather than the newest r30. libapad is plain C99 with no toolchain
# demands at all, so the newest NDK buys nothing and an LTS line is the one
# most likely to still resolve when someone rebuilds this in a year.
APAD_NDK_VERSION=28.2.13676358
# CMake 3.x deliberately: CMake 4 dropped compatibility with
# cmake_minimum_required below 3.5, and AGP's own generated scripts have
# been caught by that.
APAD_CMAKE_VERSION=3.31.6

# ---- Gradle / AGP / Kotlin --------------------------------------------
# Consumed by clients/android/gradle/wrapper/gradle-wrapper.properties and
# clients/android/gradle/libs.versions.toml, which are the files Gradle
# actually reads. Duplicated here so one file answers "what versions?".
APAD_GRADLE_VERSION=9.7.0
APAD_AGP_VERSION=9.3.1
# AGP 9 owns the Kotlin compiler version (it rejects org.jetbrains.kotlin.android
# entirely), so this is a record of what AGP 9.3.1 bundles, not a pin we set.
APAD_KOTLIN_VERSION=bundled-with-agp
